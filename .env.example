# Copy to .env and fill in.
PORT=3000
# OpenAI (or any OpenAI-compatible) API key. Leave empty for offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL (e.g. local Ollama proxy, Azure, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: ElevenLabs TTS for a natural voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
